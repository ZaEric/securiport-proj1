# Schema to store in data/runs/passengername

# basic info about each run (input.json)

# example curated url run:
{
  "run_id": "2026-06-27_001_john_doe",
  "created_at": "2026-06-27T18:42:00Z",
  "target_name": "John Doe",
  "input_mode": "curated_urls",
  "curated_urls_file": "data/curated/curated_urls.json",
  "requested_urls": [
    "https://example-news.com/article1",
    "https://example-blog.com/post2"
  ],
}

# example search api run:
{
  "run_id": "2026-06-27_002_john_doe",
  "created_at": "2026-06-27T19:10:00Z",
  "target_name": "John Doe",
  "input_mode": "search_api",
  "search_provider": "bing",
  "search_query": "\"John Doe\" news",
  "max_urls": 5,
}

# example synthetic dataset run:
{
  "run_id": "2026-06-27_003_synthetic_negative_001",
  "created_at": "2026-06-27T19:30:00Z",
  "target_name": "John Doe",
  "input_mode": "synthetic",
  "synthetic_case_file": "data/synthetic/passengers/synthetic_negative_001.json",
  "expected_overall_sentiment": "negative",
  "notes": "Short human-readable note about what this case tests.",
  "difficulty_tags": ["multiple_people", "non_criminal_negative"],
  "expected_failure_modes": [],
}

# store all sources in one file (sources.json)
{
  "run_id": "run_2026_06_27_001",
  "target_name": "John Doe",
  "sources": [
    {
      "source_id": "src_001",
      "url": "https://example.com/article",
      "title": "Article About John Doe",
      "retrieved_at": "2026-06-12T10:30:00Z",
      "article_text": "Full extracted article text..."
    },
    {
      "source_id": "src_002",
      "url": "https://example.com/profile",
      "title": "John Doe Community Profile",
      "retrieved_at": "2026-06-12T10:31:00Z",
      "article_text": "Full extracted article text..."
    }
  ],
  "metadata": {
    "source_mode": "synthetic", # or search_api or curated_urls
    "source_count": 3
  }
}

# source schema for scraped vs synthetic

# Scraped source schema (search_api or curated_urls)
{
  "source_id": "src_001",
  "url": "https://example.com/article",
  "title": "Article About John Doe",
  "retrieved_at": "2026-06-12T10:30:00Z",
  "article_text": "Full extracted article text..."
}

# Synthetic source schema
{
  "source_id": "src_001",
  "url": "synthetic://synthetic_negative_001/src_001",
  "title": "Synthetic Source Title",
  "expected_source_sentiment": "negative",
  "article_text": "Synthetic article text goes here."
}

# chunking schema for each chunk:
{
  "chunk_id": "src_001_chunk_001",
  "source_id": "src_001",
  "text": "...",
  "word_count": 123
}

# store all chunks in one file (chunks.json)
{
  "run_id": "run_2026_06_27_001",
  "target_name": "John Doe",
  "chunks": [
    {
      "chunk_id": "src_001_chunk_001",
      "source_id": "src_001",
      "text": "...",
      "word_count": 123
    },
    {
      "chunk_id": "src_001_chunk_002",
      "source_id": "src_001",
      "text": "...",
      "word_count": 123
    },
    ...
  ],
  "metadata": {
    "chunking_strategy": "paragraph_aware",
    "target_chunk_words": 600,
    "max_chunk_words": 700,
    "overlap_paragraphs": 1,
  }
}

# chunking.json if using sentiment classifier (just change metadata part)
{
  "metadata": {
    "chunking_strategy": "sentence_window",
    "window_before": 1,
    "window_after": 1,
    "evidence_unit": "target_sentence"
  }
}

# store all extracted evidence snippets (evidence.json)
{
  "run_id": "2026-06-27_001_john_doe",
  "target_name": "John Doe",
  "evidence_extraction_method": "llm_quote_extraction",
  "evidence": [
    {
      "evidence_id": "ev_001",
      "source_id": "src_001",
      "chunk_id": "src_001_chunk_002",
      "quote": "John Doe was mentioned in connection with an investigation.",
      "sentiment": "negative",
      "confidence": null #null if LLM, confidence score if sentiment classifier
    },
    ...
  ]
}

# aggregate sentiment score/counting across evidence and sources (aggregation.json)
{
  "run_id": "2026-06-27_001_john_doe",
  "target_name": "John Doe",
  "aggregation_method": "label_count_majority",
  "source_results": [
    {
      "source_id": "src_001",
      "source_sentiment": "negative",
      "source_confidence": null,
      "sentiment_counts": {
        "positive": 0,
        "neutral": 0,
        "negative": 2
      },
      "evidence_ids": ["ev_001", "ev_002"]
    },
    ...
  ],
  "overall_result": {
    "overall_sentiment": "negative",
    "overall_confidence": null,
    "source_sentiment_counts": {
      "positive": 1,
      "neutral": 1,
      "negative": 1
    },
    "evidence_sentiment_counts": {
      "positive": 1,
      "neutral": 1,
      "negative": 2
    },
    "mixed_evidence": true,
    "insufficient_evidence": false
  }
}


# final report (final_report.json)
{
  "run_id": "2026-06-27_001_john_doe",
  "target_name": "John Doe",
  "overall_sentiment": "negative",
  "overall_confidence": null # null if LLM, confidence score if sentiment classifier
  "one_line_summary": "Public sources contain both positive community-related coverage and significant negative legal findings concerning John Doe.",
  "extended_summary": "The analyzed sources present a mixed public profile for John Doe. One source reports that he was involved in an investigation and was later convicted of assault and sentenced to three years in prison. Another source describes positive community involvement. The overall sentiment is negative because the legal conviction and prison sentence represent stronger negative evidence.",
