## Just for reference for us
# Schema for synthetic dataset, 1 json per passenger name
{
  "run_id": "synthetic_negative_001",
  "target_name": "John Doe",
  "expected_overall_sentiment": "negative",
  "case_notes": "Short human-readable note about what this case tests.",
  "sources": [
    {
      "source_id": "src_001",
      "url": "synthetic://synthetic_negative_001/src_001",
      "title": "Synthetic Source Title",
      "expected_source_sentiment": "negative",
      "article_text": "Synthetic article text goes here."
    },
    {
        "source_id": "src_002",
        "url": "synthetic://synthetic_negative_001/src_002",
        "title": "Synthetic Source Title 2",
        "expected_source_sentiment": "negative",
        "article_text": "Synthetic article text goes here."
    },
    ...
  ]
}

